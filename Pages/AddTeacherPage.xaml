<Page x:Class="UP01_Faradzhov_Schedule.Pages.AddTeacherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Добавление преподавателя">

    <Grid Background="{DynamicResource BackgroundColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource SurfaceColor}" 
                    BorderBrush="{DynamicResource BorderBrushColor}" 
                    BorderThickness="1" CornerRadius="10" 
                    Padding="30,25" Width="500" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Margin="20">
                <StackPanel>
                    <TextBlock Text="Добавление преподавателя в систему" 
                               FontSize="18" FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Foreground="{DynamicResource PrimaryDarkColor}"/>

                    <TextBlock Text="Заполнение кадровых сведений сотрудника кафедры" 
                               FontSize="12" Foreground="{DynamicResource MutedTextColor}" 
                               HorizontalAlignment="Center" Margin="0,4,0,18"/>

                    <TextBlock Text="ФИО преподавателя *" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbFullName" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Отделение / Кафедра *" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <ComboBox x:Name="cmbDepartment" Height="34" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="Id"/>

                    <TextBlock Text="Ученая степень / Должность *" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbDegree" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"
                             Text="Преподаватель высшей категории"/>

                    <TextBlock Text="Электронная почта" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbEmail" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Телефон" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbPhone" Height="34" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                    <Button x:Name="btnSave" Content="Сохранить преподавателя" 
                            Height="38" Margin="0,0,0,10"
                            Background="{DynamicResource PrimaryColor}" 
                            Foreground="White" FontWeight="Bold" FontSize="14"
                            Click="btnSave_Click"/>

                    <Button Content="Отмена" 
                            Height="34" Background="Transparent" 
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Foreground="{DynamicResource TextColor}"
                            Click="btnCancel_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
