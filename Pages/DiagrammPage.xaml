<Page x:Class="UP01_Faradzhov_Schedule.Pages.DiagrammPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
      Title="Аналитика и отчёты">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Селекторы параметров диаграммы -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Метрика анализа:" FontSize="11" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbMetric" Height="34" SelectionChanged="UpdateChart">
                        <ComboBoxItem Content="Нагрузка преподавателей (кол-во пар)" IsSelected="True"/>
                        <ComboBoxItem Content="Загруженность по дням недели"/>
                        <ComboBoxItem Content="Структура занятий по типам (Лекции / Практики)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,15,0">
                    <TextBlock Text="Вид диаграммы:" FontSize="11" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbChartType" Height="34" SelectionChanged="UpdateChart">
                        <ComboBoxItem Content="Столбчатая диаграмма (Column)" IsSelected="True"/>
                        <ComboBoxItem Content="Круговая диаграмма (Pie)"/>
                        <ComboBoxItem Content="Линейный график (Line)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="Студент: Фараджов Р.Э. (4ИСИП-523)" FontWeight="Bold" Foreground="{DynamicResource PrimaryDarkColor}" FontSize="12"/>
                    <TextBlock Text="Руководитель: Аксёнова Т.Г." Foreground="{DynamicResource MutedTextColor}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Область графиков LiveCharts -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid>
                <lvc:CartesianChart x:Name="CartesianChartControl" Visibility="Visible">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis x:Name="AxisX" LabelsRotation="15">
                            <lvc:Axis.Separator>
                                <lvc:Separator Step="1" IsEnabled="False"/>
                            </lvc:Axis.Separator>
                        </lvc:Axis>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis x:Name="AxisY" MinValue="0"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>

                <lvc:PieChart x:Name="PieChartControl" Visibility="Collapsed" LegendLocation="Right"/>
            </Grid>
        </Border>

        <!-- Кнопки экспорта отчетов -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="8" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Экспорт расписания и сводной ведомости в официальные форматы:" 
                           VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextColor}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>

                <Button Grid.Column="1" Content="📄 Экспорт в Word (.docx)" 
                        Height="34" Width="190" Margin="0,0,10,0"
                        Background="#2B579A" Foreground="White" FontWeight="Bold"
                        Click="btnExportWord_Click"/>

                <Button Grid.Column="2" Content="📊 Экспорт в Excel (.xlsx)" 
                        Height="34" Width="190" Margin="0,0,10,0"
                        Background="#217346" Foreground="White" FontWeight="Bold"
                        Click="btnExportExcel_Click"/>

                <Button Grid.Column="3" Content="📑 Экспорт в PDF (.pdf)" 
                        Height="34" Width="180"
                        Background="#B30B00" Foreground="White" FontWeight="Bold"
                        Click="btnExportPdf_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
