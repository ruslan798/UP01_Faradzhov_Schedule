<Page x:Class="UP01_Faradzhov_Schedule.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Авторизация">

    <Grid Background="{DynamicResource BackgroundColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource SurfaceColor}" 
                    BorderBrush="{DynamicResource BorderBrushColor}" 
                    BorderThickness="1" CornerRadius="10" 
                    Padding="35,30" Width="440" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Margin="20">
                <StackPanel>
                    <Image Source="/res/app_logo.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Автоматизированное расписание" 
                               FontSize="20" FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Foreground="{DynamicResource PrimaryDarkColor}" 
                               TextAlignment="Center"/>

                    <TextBlock Text="Вход в корпоративную систему" 
                               FontSize="13" Foreground="{DynamicResource MutedTextColor}" 
                               HorizontalAlignment="Center" Margin="0,4,0,20"/>

                    <TextBlock Text="Логин" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbLogin" Height="36" 
                             ToolTip="Введите ваш уникальный логин пользователя" 
                             VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Пароль" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextColor}"/>
                    <PasswordBox x:Name="pbPassword" Height="36" 
                                 ToolTip="Введите пароль учетной записи" 
                                 VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                    <!-- Панель капчи -->
                    <StackPanel x:Name="captchaPanel" Visibility="Collapsed" Margin="0,0,0,15">
                        <TextBlock Text="Защитный код (Капча):" FontWeight="Bold" Foreground="#D9534F" Margin="0,0,0,6"/>

                        <Border Background="{DynamicResource BackgroundColor}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtCaptcha" Grid.Column="0" 
                                           Text="A1B2C3" FontSize="20" FontWeight="ExtraBold" 
                                           FontStyle="Italic"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource PrimaryDarkColor}"/>

                                <Button Grid.Column="1" Content="↻" Width="36" Height="34" 
                                        ToolTip="Сгенерировать другой код капчи"
                                        Click="btnRefreshCaptcha_Click" 
                                        Background="{DynamicResource SurfaceColor}"
                                        Foreground="{DynamicResource TextColor}"/>
                            </Grid>
                        </Border>

                        <TextBox x:Name="tbCaptchaInput" Height="34" Margin="0,8,0,0" 
                                 VerticalContentAlignment="Center"
                                 ToolTip="Введите 6 символов, отображаемых выше"
                                 CommandManager.PreviewExecuted="tbCaptchaInput_PreviewExecuted"/>

                        <Button x:Name="btnConfirmCaptcha" Content="Подтвердить капчу" 
                                Height="34" Margin="0,8,0,0"
                                Background="{DynamicResource PrimaryColor}" 
                                Foreground="White" FontWeight="Bold"
                                Click="btnConfirmCaptcha_Click"/>
                    </StackPanel>

                    <Button x:Name="btnEnter" Content="Войти" 
                            Height="38" Margin="0,5,0,12" 
                            Background="{DynamicResource PrimaryColor}" 
                            Foreground="White" FontWeight="Bold" FontSize="14"
                            Click="btnEnter_Click"/>

                    <Button x:Name="btnRegister" Content="Зарегистрироваться" 
                            Height="34" Margin="0,0,0,10"
                            Background="Transparent" 
                            BorderBrush="{DynamicResource BorderBrushColor}" 
                            BorderThickness="1"
                            Foreground="{DynamicResource TextColor}"
                            Click="btnRegister_Click"/>

                    <Button Content="Забыли пароль? / Сменить пароль" 
                            Background="Transparent" BorderThickness="0" 
                            Foreground="{DynamicResource PrimaryColor}" 
                            FontSize="12" Cursor="Hand"
                            Click="btnChangePassword_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
