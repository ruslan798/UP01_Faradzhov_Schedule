<Page x:Class="UP01_Faradzhov_Schedule.Pages.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель быстрых действий -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" 
                BorderBrush="{DynamicResource BorderBrushColor}" 
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="🛠 Панель администратора учебной части" 
                               FontSize="16" FontWeight="Bold" 
                               Foreground="{DynamicResource PrimaryDarkColor}" 
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Полный доступ к CRUD операциям расписания и отчетам" 
                               FontSize="12" Foreground="{DynamicResource MutedTextColor}" 
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="📊 Аналитика и отчеты (Word/Excel/PDF)" 
                        Height="34" Width="280"
                        Background="{DynamicResource PrimaryColor}" 
                        Foreground="White" FontWeight="Bold"
                        Click="btnGoToDiagrams_Click"/>
            </Grid>
        </Border>

        <!-- Вкладки управления данными -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- Вкладка 1: Управление расписанием -->
            <TabItem Header="📅 Расписание занятий" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Добавить занятие" Height="32" Width="170" Margin="0,0,10,0"
                                Background="{DynamicResource PrimaryColor}" Foreground="White" FontWeight="Bold"
                                Click="btnAddSchedule_Click"/>

                        <Button Content="✏️ Редактировать" Height="32" Width="150" Margin="0,0,10,0"
                                Background="{DynamicResource SurfaceColor}" Foreground="{DynamicResource TextColor}"
                                BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                Click="btnEditSchedule_Click"/>

                        <Button Content="🗑 Удалить" Height="32" Width="120"
                                Background="#D9534F" Foreground="White" FontWeight="Bold"
                                Click="btnDeleteSchedule_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgSchedule" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="День" Binding="{Binding DayOfWeek}" Width="105"/>
                            <DataGridTextColumn Header="Пара / Время" Binding="{Binding TimeSlot.DisplayTime}" Width="150"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group.GroupName}" Width="100"/>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding Subject.Name}" Width="2*"/>
                            <DataGridTextColumn Header="Преподаватель" Binding="{Binding Teacher.FullName}" Width="1.8*"/>
                            <DataGridTextColumn Header="Аудитория" Binding="{Binding Classroom.RoomNumber}" Width="90"/>
                            <DataGridTextColumn Header="Тип занятия" Binding="{Binding LessonType}" Width="120"/>
                            <DataGridTextColumn Header="Неделя" Binding="{Binding WeekType}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Преподаватели -->
            <TabItem Header="👨‍🏫 Преподаватели" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Добавить преподавателя" Height="32" Width="210" Margin="0,0,10,0"
                                Background="{DynamicResource PrimaryColor}" Foreground="White" FontWeight="Bold"
                                Click="btnAddTeacher_Click"/>

                        <Button Content="🗑 Удалить преподавателя" Height="32" Width="190"
                                Background="#D9534F" Foreground="White" FontWeight="Bold"
                                Click="btnDeleteTeacher_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="dgTeachers" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="ФИО преподавателя" Binding="{Binding FullName}" Width="2*"/>
                            <DataGridTextColumn Header="Отделение" Binding="{Binding Department.Name}" Width="1.8*"/>
                            <DataGridTextColumn Header="Ученая степень / Должность" Binding="{Binding AcademicDegree}" Width="1.8*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="160"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Учебные группы -->
            <TabItem Header="👥 Учебные группы" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Margin="0,10,0,0">
                    <DataGrid x:Name="dgGroups" AutoGenerateColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Название группы" Binding="{Binding GroupName}" Width="160"/>
                            <DataGridTextColumn Header="Отделение" Binding="{Binding Department.Name}" Width="2*"/>
                            <DataGridTextColumn Header="Курс" Binding="{Binding CourseNumber}" Width="90"/>
                            <DataGridTextColumn Header="Студентов в группе" Binding="{Binding StudentCount}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 4: Аудитории -->
            <TabItem Header="🏢 Аудитории" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Margin="0,10,0,0">
                    <DataGrid x:Name="dgRooms" AutoGenerateColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Номер аудитории" Binding="{Binding RoomNumber}" Width="140"/>
                            <DataGridTextColumn Header="Корпус" Binding="{Binding Building}" Width="160"/>
                            <DataGridTextColumn Header="Вместимость (чел.)" Binding="{Binding Capacity}" Width="140"/>
                            <DataGridTextColumn Header="Тип аудитории" Binding="{Binding RoomType}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Проектор" Binding="{Binding HasProjector}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
