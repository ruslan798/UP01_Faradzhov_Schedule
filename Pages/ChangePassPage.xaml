<Page x:Class="UP01_Faradzhov_Schedule.Pages.ChangePassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Смена пароля">

    <Grid Background="{DynamicResource BackgroundColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Background="{DynamicResource SurfaceColor}" 
                    BorderBrush="{DynamicResource BorderBrushColor}" 
                    BorderThickness="1" CornerRadius="10" 
                    Padding="35,25" Width="460" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Margin="20">
                <StackPanel>
                    <TextBlock Text="Смена пароля учетной записи" 
                               FontSize="19" FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Foreground="{DynamicResource PrimaryDarkColor}"/>

                    <TextBlock Text="Обновление пароля безопасности в сервисе" 
                               FontSize="13" Foreground="{DynamicResource MutedTextColor}" 
                               HorizontalAlignment="Center" Margin="0,4,0,20"/>

                    <TextBlock Text="Логин" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbLogin" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Текущий пароль" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <PasswordBox x:Name="pbOldPassword" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Новый пароль (не менее 6 знаков)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <PasswordBox x:Name="pbNewPassword" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"/>

                    <TextBlock Text="Подтверждение нового пароля" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <PasswordBox x:Name="pbConfirmNewPassword" Height="34" Margin="0,0,0,20" VerticalContentAlignment="Center"/>

                    <Button x:Name="btnSavePassword" Content="Сохранить новый пароль" 
                            Height="38" Margin="0,0,0,10"
                            Background="{DynamicResource PrimaryColor}" 
                            Foreground="White" FontWeight="Bold" FontSize="14"
                            Click="btnSavePassword_Click"/>

                    <Button Content="Отмена / Назад" 
                            Height="34" Background="Transparent" 
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Foreground="{DynamicResource TextColor}"
                            Click="btnCancel_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
