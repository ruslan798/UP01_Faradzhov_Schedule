<Page x:Class="UP01_Faradzhov_Schedule.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Каталог расписания">

    <Grid Margin="15">
        <TabControl Background="Transparent" BorderThickness="0">

            <!-- Вкладка 1: Просмотр расписания занятий -->
            <TabItem Header="📅 Расписание занятий" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель поиска и фильтрации -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" 
                            BorderBrush="{DynamicResource BorderBrushColor}" 
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Поиск -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Поиск (группа, предмет, преподаватель, аудитория):" FontSize="11" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="tbSearch" Height="32" VerticalContentAlignment="Center"
                                             TextChanged="FilterChanged"/>
                                </StackPanel>

                                <!-- Фильтр по дню недели -->
                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                    <TextBlock Text="День недели:" FontSize="11" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cmbDayFilter" Height="32" SelectionChanged="FilterChanged">
                                        <ComboBoxItem Content="Все дни недели" IsSelected="True"/>
                                        <ComboBoxItem Content="Понедельник"/>
                                        <ComboBoxItem Content="Вторник"/>
                                        <ComboBoxItem Content="Среда"/>
                                        <ComboBoxItem Content="Четверг"/>
                                        <ComboBoxItem Content="Пятница"/>
                                        <ComboBoxItem Content="Суббота"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Фильтр по неделе -->
                                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                    <TextBlock Text="Тип недели:" FontSize="11" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cmbWeekFilter" Height="32" SelectionChanged="FilterChanged">
                                        <ComboBoxItem Content="Все недели" IsSelected="True"/>
                                        <ComboBoxItem Content="Числитель"/>
                                        <ComboBoxItem Content="Знаменатель"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Сортировка -->
                                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                    <TextBlock Text="Сортировка:" FontSize="11" Foreground="{DynamicResource MutedTextColor}" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="cmbSort" Height="32" SelectionChanged="FilterChanged">
                                        <ComboBoxItem Content="По дням недели и парам" IsSelected="True"/>
                                        <ComboBoxItem Content="По группе (А-Я)"/>
                                        <ComboBoxItem Content="По дисциплине (А-Я)"/>
                                        <ComboBoxItem Content="По преподавателю (А-Я)"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Сброс фильтров -->
                                <Button Grid.Column="4" Content="Сбросить" Height="32" Width="90" 
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource SurfaceColor}"
                                        Foreground="{DynamicResource TextColor}"
                                        BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                                        Click="btnResetFilters_Click"/>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox x:Name="cbOnlyLectures" Content="Только лекции" 
                                          VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>

                                <TextBlock x:Name="txtRecordCount" Grid.Column="1" 
                                           Text="Найдено: 0 из 0" FontSize="12" FontWeight="SemiBold" 
                                           Foreground="{DynamicResource PrimaryDarkColor}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Таблица расписания -->
                    <DataGrid Grid.Row="1" x:Name="dgSchedule" 
                              AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionMode="Single"
                              ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="День недели" Binding="{Binding DayOfWeek}" Width="110"/>
                            <DataGridTextColumn Header="Пара / Время" Binding="{Binding TimeSlot.DisplayTime}" Width="150"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding Group.GroupName}" Width="95"/>
                            <DataGridTextColumn Header="Дисциплина" Binding="{Binding Subject.Name}" Width="2*"/>
                            <DataGridTextColumn Header="Преподаватель" Binding="{Binding Teacher.FullName}" Width="1.8*"/>
                            <DataGridTextColumn Header="Аудитория" Binding="{Binding Classroom.RoomNumber}" Width="90"/>
                            <DataGridTextColumn Header="Тип занятия" Binding="{Binding LessonType}" Width="120"/>
                            <DataGridTextColumn Header="Неделя" Binding="{Binding WeekType}" Width="100"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Карточки преподавателей -->
            <TabItem Header="👨‍🏫 Преподаватели" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource SurfaceColor}" 
                            BorderBrush="{DynamicResource BorderBrushColor}" 
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="tbTeacherSearch" Height="32" VerticalContentAlignment="Center"
                                     ToolTip="Поиск преподавателя по ФИО или ученой степени"
                                     TextChanged="tbTeacherSearch_TextChanged"/>
                            <TextBlock x:Name="txtTeacherCount" Grid.Column="1" 
                                       Text="Всего: 0" Margin="15,0,0,0" 
                                       VerticalAlignment="Center" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource PrimaryDarkColor}"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" x:Name="lvTeachers" 
                              BorderThickness="0" Background="Transparent" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SurfaceColor}" 
                                        BorderBrush="{DynamicResource BorderBrushColor}" 
                                        BorderThickness="1" CornerRadius="8" 
                                        Margin="8" Padding="12" Width="260" Height="320">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="160"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding FullName}" 
                                                   FontWeight="Bold" FontSize="13" 
                                                   TextAlignment="Center" TextWrapping="Wrap" 
                                                   Foreground="{DynamicResource PrimaryDarkColor}" Margin="0,0,0,6"/>

                                        <Border Grid.Row="1" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource BackgroundColor}" Margin="0,0,0,8">
                                            <Image Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Image.Source>
                                                    <Binding Path="Photo">
                                                        <Binding.TargetNullValue>
                                                            <BitmapImage UriSource="/res/default_avatar.png"/>
                                                        </Binding.TargetNullValue>
                                                        <Binding.FallbackValue>
                                                            <BitmapImage UriSource="/res/default_avatar.png"/>
                                                        </Binding.FallbackValue>
                                                    </Binding>
                                                </Image.Source>
                                            </Image>
                                        </Border>

                                        <TextBlock Grid.Row="2" Text="{Binding AcademicDegree}" 
                                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{DynamicResource TextColor}"/>

                                        <TextBlock Grid.Row="3" Text="{Binding Department.Name, StringFormat='Отделение: {0}'}" 
                                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                                   Foreground="{DynamicResource MutedTextColor}" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Вкладка 3: Аудитории -->
            <TabItem Header="🏢 Аудитории" FontSize="14" FontWeight="SemiBold" Padding="15,6">
                <Grid Margin="0,10,0,0">
                    <DataGrid x:Name="dgClassrooms" AutoGenerateColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ Кабинета" Binding="{Binding RoomNumber}" Width="120"/>
                            <DataGridTextColumn Header="Корпус" Binding="{Binding Building}" Width="160"/>
                            <DataGridTextColumn Header="Вместимость (чел.)" Binding="{Binding Capacity}" Width="140"/>
                            <DataGridTextColumn Header="Тип аудитории" Binding="{Binding RoomType}" Width="2*"/>
                            <DataGridCheckBoxColumn Header="Проектор / Мультимедиа" Binding="{Binding HasProjector}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
