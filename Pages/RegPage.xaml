<Page x:Class="UP01_Faradzhov_Schedule.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация пользователя">

    <Grid Background="{DynamicResource BackgroundColor}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Background="{DynamicResource SurfaceColor}" 
                    BorderBrush="{DynamicResource BorderBrushColor}" 
                    BorderThickness="1" CornerRadius="10" 
                    Padding="35,25" Width="500" 
                    HorizontalAlignment="Center" VerticalAlignment="Center" 
                    Margin="20">
                <StackPanel>
                    <TextBlock Text="Регистрация в системе" 
                               FontSize="20" FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Foreground="{DynamicResource PrimaryDarkColor}"/>

                    <TextBlock Text="Создание личного кабинета преподавателя или студента" 
                               FontSize="13" Foreground="{DynamicResource MutedTextColor}" 
                               HorizontalAlignment="Center" Margin="0,4,0,20"/>

                    <TextBlock Text="ФИО *" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbFullName" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"
                             ToolTip="Введите полное имя (Фамилия Имя Отчество)"/>

                    <TextBlock Text="Логин *" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbLogin" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"
                             ToolTip="Уникальный логин на латинице"/>

                    <TextBlock Text="Электронная почта" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbEmail" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"
                             ToolTip="Адрес корпоративной или личной почты"/>

                    <TextBlock Text="Телефон" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <TextBox x:Name="tbPhone" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"
                             ToolTip="Контактный номер телефона (+7...)"/>

                    <TextBlock Text="Пароль * (не менее 6 символов, буквы и цифры)" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <PasswordBox x:Name="pbPassword" Height="34" Margin="0,0,0,12" VerticalContentAlignment="Center"
                                 ToolTip="Пароль должен состоять минимум из 6 символов, содержать цифры и латинские буквы"/>

                    <TextBlock Text="Подтверждение пароля *" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextColor}"/>
                    <PasswordBox x:Name="pbConfirmPassword" Height="34" Margin="0,0,0,20" VerticalContentAlignment="Center"
                                 ToolTip="Повторите введенный пароль"/>

                    <Button x:Name="btnSubmitRegister" Content="Зарегистрироваться" 
                            Height="38" Margin="0,0,0,10"
                            Background="{DynamicResource PrimaryColor}" 
                            Foreground="White" FontWeight="Bold" FontSize="14"
                            Click="btnSubmitRegister_Click"/>

                    <Button Content="Вернуться ко входу" 
                            Height="34" Background="Transparent" 
                            BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1"
                            Foreground="{DynamicResource TextColor}"
                            Click="btnCancel_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
